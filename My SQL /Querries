USE adventure_works_dw;

INSERT INTO fact_sales (
    ProductKey,
    CustomerKey,
    ResellerKey,
    EmployeeKey,
    SalesTerritoryKey,
    SalesOrderNumber,
    SalesOrderLineNumber,
    DiscountAmount,
    TotalProductCost,
    SalesAmount,
    Freight,
    OrderDate,
    DueDate,
    ShipDate,
    SalesChannel
)
SELECT
    CAST(ProductKey AS UNSIGNED),
    NULLIF(CustomerKey, ''),
    NULLIF(ResellerKey, ''),
    NULLIF(EmployeeKey, ''),
    CAST(SalesTerritoryKey AS UNSIGNED),
    SalesOrderNumber,
    CAST(SalesOrderLineNumber AS UNSIGNED),
    CAST(DiscountAmount AS DECIMAL(18,4)),
    CAST(TotalProductCost AS DECIMAL(18,4)),
    CAST(SalesAmount AS DECIMAL(18,4)),
    CAST(Freight AS DECIMAL(18,4)),
    STR_TO_DATE(OrderDate, '%Y-%m-%d'),
    STR_TO_DATE(DueDate, '%Y-%m-%d'),
    STR_TO_DATE(ShipDate, '%Y-%m-%d'),
    SalesChannel
FROM fact_sales_staging;
-----------------------------------------------------------------------------------------------------------------
SELECT
    COUNT(*) AS RowCount,
    COUNT(DISTINCT SalesOrderNumber) AS TotalOrders,
    COUNT(DISTINCT CONCAT(SalesOrderNumber, '-', SalesOrderLineNumber)) AS UniqueOrderLines
FROM adventure_works_dw.fact_sales;
-----------------------------------------------------------------------------------------------------------------
SELECT
    SalesChannel,
    COUNT(*) AS SalesLines,
    COUNT(DISTINCT SalesOrderNumber) AS Orders,
    SUM(SalesAmount) AS TotalSales,
    COUNT(CustomerKey) AS CustomerRows,
    COUNT(ResellerKey) AS ResellerRows,
    COUNT(EmployeeKey) AS EmployeeRows
FROM adventure_works_dw.fact_sales
GROUP BY SalesChannel;
