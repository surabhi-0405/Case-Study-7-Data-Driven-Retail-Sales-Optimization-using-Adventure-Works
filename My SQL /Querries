USE adventure_works_dw;

CREATE TABLE fact_sales (
    SalesKey BIGINT AUTO_INCREMENT PRIMARY KEY,
    ProductKey INT NOT NULL,
    CustomerKey INT NULL,
    ResellerKey INT NULL,
    EmployeeKey INT NULL,
    SalesTerritoryKey INT NOT NULL,
    SalesOrderNumber VARCHAR(30) NOT NULL,
    SalesOrderLineNumber INT NOT NULL,
    DiscountAmount DECIMAL(18,4) NOT NULL,
    TotalProductCost DECIMAL(18,4) NOT NULL,
    SalesAmount DECIMAL(18,4) NOT NULL,
    Freight DECIMAL(18,4) NOT NULL,
    CarrierTrackingNumber VARCHAR(50) NULL,
    OrderDate DATE NOT NULL,
    DueDate DATE NOT NULL,
    ShipDate DATE NOT NULL,
    SalesChannel VARCHAR(20) NOT NULL
);
