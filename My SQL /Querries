SELECT
    'ProductKey' AS ForeignKeyName,
    COUNT(*) AS InvalidRows
FROM fact_sales f
LEFT JOIN dim_product d
    ON f.ProductKey = d.ProductKey
WHERE d.ProductKey IS NULL

UNION ALL

SELECT
    'CustomerKey',
    COUNT(*)
FROM fact_sales f
LEFT JOIN dim_customer d
    ON f.CustomerKey = d.CustomerKey
WHERE f.CustomerKey IS NOT NULL
  AND d.CustomerKey IS NULL

UNION ALL

SELECT
    'ResellerKey',
    COUNT(*)
FROM fact_sales f
LEFT JOIN dim_reseller d
    ON f.ResellerKey = d.ResellerKey
WHERE f.ResellerKey IS NOT NULL
  AND d.ResellerKey IS NULL

UNION ALL

SELECT
    'EmployeeKey',
    COUNT(*)
FROM fact_sales f
LEFT JOIN dim_employee d
    ON f.EmployeeKey = d.EmployeeKey
WHERE f.EmployeeKey IS NOT NULL
  AND d.EmployeeKey IS NULL

UNION ALL

SELECT
    'SalesTerritoryKey',
    COUNT(*)
FROM fact_sales f
LEFT JOIN dim_sales_territory d
    ON f.SalesTerritoryKey = d.SalesTerritoryKey
WHERE d.SalesTerritoryKey IS NULL

UNION ALL

SELECT
    'OrderDate',
    COUNT(*)
FROM fact_sales f
LEFT JOIN dim_date d
    ON f.OrderDate = d.Date
WHERE d.Date IS NULL;
