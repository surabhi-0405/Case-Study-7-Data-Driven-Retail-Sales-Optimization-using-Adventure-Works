USE adventure_works_dw;

-- ============================================================
-- 1. DIM CUSTOMER
-- ============================================================
CREATE TABLE dim_customer (
    CustomerKey INT PRIMARY KEY,
    GeographyKey INT,
    CustomerName VARCHAR(150),
    BirthDate DATE,
    MaritalStatus VARCHAR(10),
    Gender VARCHAR(10),
    EmailAddress VARCHAR(150),
    YearlyIncome DECIMAL(15,2),
    Education VARCHAR(100),
    Occupation VARCHAR(100),
    HouseOwnerFlag INT,
    Address VARCHAR(255),
    FirstPurchaseDate DATE,
    Age INT,
    AgeGroup VARCHAR(20)
);

-- ============================================================
-- 2. DIM EMPLOYEE
-- ============================================================
CREATE TABLE dim_employee (
    EmployeeKey INT PRIMARY KEY,
    ParentEmployeeKey INT NULL,
    SalesTerritoryKey INT,
    EmployeeName VARCHAR(150),
    Title VARCHAR(150),
    EmailAddress VARCHAR(150),
    DepartmentName VARCHAR(100),
    HireDate DATE,
    BirthDate DATE
);

-- ============================================================
-- 3. DIM GEOGRAPHY
-- ============================================================
CREATE TABLE dim_geography (
    GeographyKey INT PRIMARY KEY,
    City VARCHAR(100),
    State VARCHAR(100),
    Country VARCHAR(100),
    PostalCode VARCHAR(20),
    SalesTerritoryKey INT
);

-- ============================================================
-- 4. DIM PRODUCT
-- ============================================================
CREATE TABLE dim_product (
    ProductKey INT PRIMARY KEY,
    ProductSubcategoryKey INT,
    Product VARCHAR(150),
    Color VARCHAR(50),
    Model VARCHAR(100),
    Subcategory VARCHAR(100),
    Category VARCHAR(100)
);

-- ============================================================
-- 5. DIM RESELLER
-- ============================================================
CREATE TABLE dim_reseller (
    ResellerKey INT PRIMARY KEY,
    GeographyKey INT,
    BusinessType VARCHAR(100),
    ResellerName VARCHAR(150)
);

-- ============================================================
-- 6. DIM SALES TERRITORY
-- ============================================================
CREATE TABLE dim_sales_territory (
    SalesTerritoryKey INT PRIMARY KEY,
    SalesTerritoryRegion VARCHAR(100),
    SalesTerritoryCountry VARCHAR(100),
    SalesTerritoryGroup VARCHAR(100)
);

-- ============================================================
-- 7. DIM DATE
-- ============================================================
CREATE TABLE dim_date (
    Date DATE PRIMARY KEY,
    Year INT,
    Quarter VARCHAR(5),
    MonthNumber INT,
    MonthName VARCHAR(20),
    YearMonth VARCHAR(10),
    Day INT,
    DayName VARCHAR(20),
    WeekNumber INT
);
