SELECT
    SalesChannel,
    COUNT(*) AS TotalSalesLines,
    COUNT(DISTINCT SalesOrderNumber) AS TotalOrders,
    ROUND(SUM(SalesAmount), 2) AS TotalSales,
    ROUND(SUM(TotalProductCost), 2) AS TotalProductCost,
    ROUND(SUM(SalesAmount - TotalProductCost), 2) AS GrossProfit
FROM fact_sales
GROUP BY SalesChannel
ORDER BY SalesChannel;
-----------------------------------------------------------------------------------------------------------------
USE adventure_works_dw;

SELECT
    COUNT(*) AS TotalSalesLines,
    COUNT(DISTINCT SalesOrderNumber) AS TotalOrders,
    ROUND(SUM(SalesAmount), 2) AS TotalSales,
    ROUND(SUM(TotalProductCost), 2) AS TotalProductCost,
    ROUND(SUM(SalesAmount - TotalProductCost), 2) AS GrossProfit,
    ROUND(
        SUM(SalesAmount - TotalProductCost)
        / NULLIF(SUM(SalesAmount), 0) * 100,
        2
    ) AS GrossProfitMarginPct
FROM fact_sales;

